{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/husseinzaher/laravel-medialibrary.git",
      "reference": "d823475caf4b41d74f64b770862da2a7a10708ca"
    },
    {
      "type": "git",
      "url": "https://github.com/husseinzaher/phpinsights.git"
    }
  ],
  "require": {
    "php": ">=8",
    "amrshawky/laravel-currency": "^5.0",
    "barryvdh/laravel-snappy": "^1.0",
    "carlos-meneses/laravel-mpdf": "^2.1",
    "cocur/slugify": "^4.0",
    "cviebrock/eloquent-sluggable": "^9.0.0",
    "fruitcake/laravel-cors": "^2.0",
    "google/apiclient": "^2.17",
    "guzzlehttp/guzzle": "^7.0.1",
    "h4cc/wkhtmltoimage-amd64": "0.12.x",
    "h4cc/wkhtmltopdf-amd64": "0.12.x",
    "jackiedo/cart": "^3.0",
    "kreait/laravel-firebase": "^4.2",
    "kutia-software-company/larafirebase": "*",
    "laravel/framework": "^9.0",
    "laravel/sanctum": "^2.15",
    "laravel/socialite": "^5.5",
    "laravel/tinker": "^2.7",
    "laravelcollective/html": "^6.3",
    "maatwebsite/excel": "^3.1",
    "moltaqa/wasl": "^1.0",
    "proengsoft/laravel-jsvalidation": "^4.7.6",
    "propaganistas/laravel-phone": "^4.3.7",
    "pusher/pusher-php-server": "^7.0",
    "realrashid/sweet-alert": "^5.1.0",
    "simplesoftwareio/simple-qrcode": "^4.2",
    "spatie/laravel-enum": "^3.0.1",
    "spatie/laravel-medialibrary": "^10.0",
    "spatie/laravel-permission": "^5.5.5",
    "spatie/laravel-translatable": "^5.2.0",
    "symfony/http-client": "^6.2",
    "symfony/mailgun-mailer": "^6.2",
    "webklex/laravel-pdfmerger": "^1.3",
    "yajra/laravel-datatables": "^9.0"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.6",
    "barryvdh/laravel-ide-helper": "^2.12.3",
    "fakerphp/faker": "^1.9.1",
    "laravel/breeze": "^1.9",
    "laravel/sail": "^1.16",
    "laravel/telescope": "^4.17",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^6.1",
    "nunomaduro/phpinsights": "dev-master",
    "phpunit/phpunit": "^9.5.10",
    "spatie/laravel-ignition": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Support\\": "app/Support/",
      "Modules\\": "app/Modules/"
    },
    "files": [
      "app/Support/helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "audit": {
        "ignore": [
            "PKSA-8qx3-n5y5-vvnd"
        ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
